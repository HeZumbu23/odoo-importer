# Kopieren nach .env und anpassen.

# --- Odoo (lokale Test-Instanz) ---
ODOO_VERSION=18.0
ODOO_DB=odoo
ODOO_LANG=de_DE
ODOO_PORT=8069
POSTGRES_PASSWORD=odoo

# --- Ziel-Odoo für den Importer ---
# Standard: lokale Instanz. Für das Produktivsystem z.B.:
# ODOO_URL=https://erp.firma.de
# ODOO_DB=prod
# ODOO_USER=importer@firma.de
# ODOO_PASSWORD=<API-Schlüssel>
ODOO_URL=http://odoo:8069
# Adresse, unter der DU Odoo im Browser öffnest (für die Links in der Oberfläche)
ODOO_PUBLIC_URL=http://localhost:8069
# API: auto (JSON-2 wenn vorhanden, sonst XML-RPC) | xmlrpc | json2
ODOO_API=auto
ODOO_USER=admin
ODOO_PASSWORD=admin

# --- IMAP (lokaler Dovecot) ---
IMAP_USERS=archiv:archiv,vertrieb:vertrieb
IMAP_PORT=1143

# Zugangsdaten, die in importer/config/importer.yaml per ${...} benutzt werden
IMAP_ARCHIV_USER=archiv
IMAP_ARCHIV_PASSWORD=archiv
IMAP_VERTRIEB_USER=vertrieb
IMAP_VERTRIEB_PASSWORD=vertrieb
# --- Externe Postfächer (bis zu drei; Beispiel für Nr. 1, Nr. 2/3 analog mit MAIL2_/MAIL3_) ---
# MAIL1_ENABLED=true
# MAIL1_HOST=imap.firma.de
# MAIL1_PORT=993
# MAIL1_SSL=true
# MAIL1_USER=info@firma.de
# MAIL1_PASSWORD=...
# Danach in der Oberfläche unter "Postfächer" das Datum "Abrufen ab" setzen.

# --- Importer ---
IMPORTER_PORT=8090
UI_USER=admin
UI_PASSWORD=admin
# Sekunden zwischen automatischen Läufen (Abrufen -> Klassifizieren -> Ausführen); 0 = nur manuell
WORKER_INTERVAL=0
# false = Regeln mit "auto: true" schlagen nur vor, alles muss in der Oberfläche freigegeben werden
AUTO_APPROVE=true
